# 复制为 .env 后按需修改；所有项均有默认值，不改也能直接 docker compose up。

# web 对外端口（浏览器入口）
WEB_PORT=8080

# Go server / edit-service 对外端口（API 直连调试用；纯浏览器使用无需暴露）
SERVER_PORT=8090
EDIT_SERVICE_PORT=8100

# 模型/上传数据目录。
# 留空 = 使用 named volume（aiifc-data，down/up 后数据保留）；
# 设为宿主机路径（如 ./data）= bind mount，便于直接查看文件。
DATA_DIR=

# PostgreSQL DSN。留空 = 文件存储（零依赖，默认）。
# 启用：`docker compose --profile pg up -d`，并设为：
# VIEWER_PG_DSN=postgres://aiifc:aiifc@postgres:5432/aiifc?sslmode=disable
VIEWER_PG_DSN=

# --profile pg 时 PostgreSQL 的连接参数（需与 VIEWER_PG_DSN 一致）
PG_USER=aiifc
PG_PASSWORD=aiifc
PG_DB=aiifc
PG_PORT=5432
