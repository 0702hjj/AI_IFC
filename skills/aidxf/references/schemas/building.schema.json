{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidxfv3.dev/schemas/building.schema.json",
  "title": "building.json v1 —— 交付契约（S4 confirmed 层封存）",
  "description": "冻结于 2026-08-10（W0 T04）。继承 V2 S4 形态：floors 楼层↔DXF 映射 + doors 门表 + metadata + checksums。bim 接口文件。改则回 W0 重走正反例。",
  "type": "object",
  "required": ["version", "project", "metadata", "floors", "doors", "checksums"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "by"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "by": { "type": "string", "minLength": 1 }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["floor", "elevation_mm", "height_mm", "dxf", "sha256"],
        "additionalProperties": false,
        "properties": {
          "floor": { "type": "string", "minLength": 1 },
          "elevation_mm": { "type": "number" },
          "height_mm": { "type": "number", "exclusiveMinimum": 0 },
          "dxf": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 1, "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "floor", "room_from", "room_to", "w_mm", "h_mm"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "floor": { "type": "string", "minLength": 1 },
          "room_from": { "type": "string", "minLength": 1 },
          "room_to": { "type": "string", "minLength": 1 },
          "w_mm": { "type": "number", "exclusiveMinimum": 0 },
          "h_mm": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
