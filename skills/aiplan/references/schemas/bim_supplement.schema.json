{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ifc.local/aiplan/bim_supplement.schema.json",
  "title": "bim_supplement.json v1 (plan→bim)",
  "type": "object",
  "required": [
    "version",
    "project",
    "source_plan_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "source_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "gable",
            "hip",
            "shed",
            "flat",
            "freeform"
          ]
        },
        "slope_deg": {
          "type": "number",
          "minimum": 25,
          "maximum": 45
        },
        "ridge_h_m": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 4.0
        },
        "overhang_m": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.6
        },
        "dormer_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "special_structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "parapet",
              "balcony",
              "atrium",
              "massing_twist",
              "massing_mirror"
            ]
          },
          "height_mm": {
            "type": "number",
            "minimum": 1100,
            "maximum": 1500
          },
          "coping": {
            "type": "boolean"
          },
          "depth_m": {
            "type": "number",
            "minimum": 1.2,
            "maximum": 1.8
          },
          "enclosure": {
            "enum": [
              "open",
              "enclosed"
            ]
          },
          "rail_h_m": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 1.2
          },
          "size_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            },
            "prefixItems": [
              {
                "type": "number",
                "minimum": 10,
                "maximum": 40
              },
              {
                "type": "number",
                "minimum": 8,
                "maximum": 30
              }
            ]
          },
          "skylight": {
            "enum": [
              "flat",
              "pyramidal",
              "barrel"
            ]
          },
          "full_height": {
            "type": "boolean"
          },
          "twist_deg": {
            "type": "number",
            "minimum": 45,
            "maximum": 180
          },
          "n_floors": {
            "type": "integer",
            "minimum": 1
          },
          "axis": {
            "enum": [
              "x",
              "y"
            ]
          },
          "scope": {
            "enum": [
              "full",
              "partial"
            ]
          }
        }
      }
    },
    "psets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "building": {
          "$ref": "#/$defs/pset_object"
        },
        "walls": {
          "$ref": "#/$defs/pset_object"
        },
        "slabs_roof": {
          "$ref": "#/$defs/pset_object"
        },
        "circulation": {
          "$ref": "#/$defs/pset_object"
        },
        "spaces": {
          "$ref": "#/$defs/pset_object"
        }
      }
    },
    "area_allocation": {
      "type": "object",
      "required": ["total_area_sqm", "blocks"],
      "additionalProperties": false,
      "properties": {
        "total_area_sqm": {"type": "number", "exclusiveMinimum": 0},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["block", "ratio"],
            "additionalProperties": false,
            "properties": {
              "block": {"type": "string", "minLength": 1},
              "ratio": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0, "maximum": 1},
                  {"type": "number", "minimum": 0, "maximum": 1}
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "area_sqm": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "exclusiveMinimum": 0},
                  {"type": "number", "exclusiveMinimum": 0}
                ],
                 "minItems": 2,
                 "maxItems": 2
               }
             }
           }
         }
       }
     },
    "space_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note"],
        "additionalProperties": false,
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "floors": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "integer", "minimum": 1},
              "to": {"type": "integer", "minimum": 1}
            }
          },
          "source": {"enum": ["user", "standard"]}
        }
      }
    }
  },
  "$defs": {
    "pset_object": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {},
      "patternProperties": {
        "^fire_exit$": {
          "type": "boolean"
        },
        "^.*_(protection|bearing|accessible|external|exit|combustible|coping|full_height)$": {
          "type": "boolean"
        },
        "^.*_transmittance$": {
          "type": "number"
        },
        "^.*_storeys$": {
          "type": "integer"
        },
        "^.*_mm$": {
          "type": "number"
        },
        "^fire_(?!exit$).*$": {
          "type": "string"
        },
        "^occupancy_type$": {
          "type": "string"
        },
        "^pitch_angle_deg$": {
          "type": "number"
        }
      }
    }
  }
}
