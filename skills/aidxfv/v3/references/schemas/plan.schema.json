{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ifc.local/aiplan/plan.schema.json",
  "title": "plan.json v3 (aiplan 自持)",
  "description": "plan 阶段产物 / cad 阶段输入（本文件即契约事实源，aiplan 自包含）。v3.1(向后兼容): outer/holes/core 统一为 ring 类型(polygon 简写 | {vertices, arcs?})——三者同类型同代码路径，支持真弧/整圆 circle_ring；core_anchor_mm 点坐标作简写保留。对齐: buildV3/geo_cognition.md §0 传透契约 / architecture D23/D25",
  "type": "object",
  "required": ["version", "project", "site", "zones"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 3},
    "project": {"type": "string", "minLength": 1},
    "site": {
      "type": "object",
      "required": ["lot_polygon_mm", "setbacks_mm"],
      "additionalProperties": false,
      "properties": {
        "lot_polygon_mm": {"$ref": "#/$defs/polygon"},
        "origin": {"const": "lot_southwest"},
        "setbacks_mm": {
          "type": "object",
          "required": ["front", "rear", "left", "right"],
          "additionalProperties": false,
          "properties": {
            "front": {"type": "number", "minimum": 0},
            "rear": {"type": "number", "minimum": 0},
            "left": {"type": "number", "minimum": 0},
            "right": {"type": "number", "minimum": 0}
          }
        },
        "north_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "function", "floors", "floor_height_mm", "outline_mm", "program"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "floors": {
            "oneOf": [
              {
                "type": "object",
                "required": ["from", "to"],
                "additionalProperties": false,
                "properties": {
                  "from": {"type": "integer", "minimum": 1},
                  "to": {"type": "integer", "minimum": 1}
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            ]
          },
          "floor_height_mm": {"type": "number", "exclusiveMinimum": 0},
          "outline_mm": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["outer"],
              "additionalProperties": false,
              "properties": {
                "outer": {
                  "oneOf": [
                    {"$ref": "#/$defs/polygon"},
                    {"$ref": "#/$defs/ring"}
                  ]
                },
                "holes": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {"$ref": "#/$defs/polygon"},
                      {"$ref": "#/$defs/ring"}
                    ]
                  }
                },
                "arcs": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/arcAnn"}
                }
              }
            }
          },
          "core_anchor_mm": {
            "oneOf": [
              {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
              {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}, "minItems": 1}
            ]
          },
          "core": {
            "oneOf": [
              {"$ref": "#/$defs/polygon"},
              {"$ref": "#/$defs/ring"},
              {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/polygon"}, {"$ref": "#/$defs/ring"}]}, "minItems": 1}
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "required": ["on"],
            "additionalProperties": false,
            "properties": {
              "on": {"type": "string", "minLength": 1},
              "align": {"type": "string", "minLength": 1}
            }
          },
          "typology_candidates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "program": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["room"],
              "additionalProperties": false,
              "properties": {
                "room": {"type": "string", "minLength": 1},
                "count": {"$ref": "#/$defs/intOrRange"},
                "area_sqm": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "exclusiveMinimum": 0},
                    {"type": "number", "exclusiveMinimum": 0}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "per_floor": {"type": "boolean"},
                "min_width_mm": {"type": "number", "exclusiveMinimum": 0},
                "includes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "area_allocation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["block", "ratio", "source"],
              "additionalProperties": false,
              "properties": {
                "block": {"type": "string", "minLength": 1},
                "ratio": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "area_sqm": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "exclusiveMinimum": 0},
                    {"type": "number", "exclusiveMinimum": 0}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "source": {"enum": ["standard", "user", "derived"]}
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "rule"],
        "additionalProperties": false,
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "strength": {"enum": ["must", "prefer", "avoid"]}
        }
      }
    },
    "vertical_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "minLength": 1}
        }
      }
    },
    "standards": {
      "type": "object",
      "required": ["packs"],
      "additionalProperties": false,
      "properties": {
        "packs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "overrides": {"type": "object"},
        "emphases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "design_rationale": {
      "type": "string",
      "minLength": 1,
      "description": "设计推理显式化（aiplan P0 迁移，单向看齐母本）：引用 derive 派生事实说明形态/核心筒/分区决策的依据。可选。"
    }
  },
  "$defs": {
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "number"}, {"type": "number"}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "arcAnn": {
      "type": "object",
      "required": ["at", "center", "radius"],
      "additionalProperties": false,
      "properties": {
        "at": {"type": "integer", "minimum": 0},
        "center": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "a0": {"type": "number"},
        "a1": {"type": "number"}
      }
    },
    "ring": {
      "type": "object",
      "required": ["vertices"],
      "additionalProperties": false,
      "properties": {
        "vertices": {"$ref": "#/$defs/polygon"},
        "arcs": {
          "type": "array",
          "items": {"$ref": "#/$defs/arcAnn"}
        }
      }
    },
    "intOrRange": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    }
  }
}
