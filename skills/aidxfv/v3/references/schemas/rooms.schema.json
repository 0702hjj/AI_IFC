{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://aidxfv3.dev/schemas/rooms.schema.json",
 "title": "rooms.json v1 —— 房间 DSL 契约（S2 rooms-worker 产出）",
 "description": "rooms 声明：承接骨架分区画分墙 + 贴标签。门窗（openings）剥离到 details 最后一步统一规律生成（D44）——rooms 只声明墙划分。",
 "type": "object",
 "oneOf": [
  {
   "required": [
    "floor"
   ],
   "not": {
    "required": [
     "status"
    ]
   }
  },
  {
   "required": [
    "status",
    "region",
    "reason"
   ]
  }
 ],
 "properties": {
  "floor": {
   "type": "string",
   "minLength": 1
  },
  "axis_grid_ref": {
   "type": "string",
   "minLength": 1
  },
  "walls": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/wall"
   }
  },
  "requirements_trace": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/trace"
   }
  },
  "deviations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "defaults_used": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "const": "infeasible"
  },
  "region": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "additionalProperties": false,
   "properties": {
    "x": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 2,
     "maxItems": 2
    },
    "y": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 2,
     "maxItems": 2
    }
   }
  },
  "reason": {
   "type": "string",
   "minLength": 1
  },
  "evidence": {
   "type": "object"
  },
  "partitions": {
   "type": "object",
   "description": "承接骨架分区（画布）——{名字: 分区引用}。分区种类由 building_types + plan 引导已定",
   "additionalProperties": {
    "type": "string",
    "minLength": 1
   }
  },
  "labels": {
   "type": "array",
   "minItems": 1,
   "description": "墙围成区域后贴房间标签——at 点落区绑定房间（机器推）",
   "items": {
    "type": "object",
    "required": [
     "room",
     "at"
    ],
    "additionalProperties": false,
    "properties": {
     "room": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$"
     },
     "type": {
      "type": "string",
      "minLength": 1
     },
     "at": {
      "$ref": "#/$defs/point_mm"
     },
     "area_sqm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "目标面积（program 区间，R-03 校验；缺省跳过）"
     },
     "placemark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "minLength": 1
       }
      },
      "description": "特殊构件占位（stair/elevator 不画实体墙）"
     },
     "frontage": {
      "enum": [
       "N",
       "S",
       "E",
       "W",
       "NE",
       "NW",
       "SE",
       "SW"
      ],
      "description": "朝向声明（faces_south → frontage:S；R-05 机检：房间贴该方向边）"
     }
    }
   }
  },
  "zone_ref": {
   "type": "string",
   "minLength": 1,
   "description": "骨架分区指针（skeleton.json#zones[<zone>]）——分区几何/标签/轴网派生不复制，引用"
  }
 },
 "additionalProperties": false,
 "$defs": {
  "wall": {
   "type": "object",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "ext",
      "int"
     ]
    },
    "t_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "axis": {
     "$ref": "#/$defs/axis"
    },
    "path": {
     "$ref": "#/$defs/axis_path"
    },
    "arc": {
     "$ref": "#/$defs/arc"
    },
    "key": {
     "type": "string",
     "minLength": 1,
      "description": "稳定唯一墙 id（建议 <floor>:<kind>:<n>，如 '1F:int:0'；缺省机器自动分配）。details 阶段门窗沿墙定位靠它"
    }
   },
   "oneOf": [
    {
     "required": [
      "axis"
     ]
    },
    {
     "required": [
      "path"
     ]
    },
    {
     "required": [
      "arc"
     ]
    }
   ]
  },
  "axis": {
   "type": "array",
   "minItems": 2,
   "description": "墙轴线点序列（mm 坐标）。2 点 = straight 直墙；3+ 点 = polyline 斜墙/折线",
   "items": {
    "$ref": "#/$defs/point_mm"
    }
   },
   "trace": {
   "type": "object",
   "required": [
    "requirement",
    "satisfied_by"
   ],
   "additionalProperties": false,
   "properties": {
    "requirement": {
     "type": "string",
     "minLength": 1
    },
    "satisfied_by": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "arc": {
   "type": "object",
   "required": [
    "center",
    "r_mm"
   ],
   "additionalProperties": false,
   "properties": {
    "center": {
     "$ref": "#/$defs/point_mm"
    },
    "r_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "a0_deg": {
     "type": "number"
    },
    "a1_deg": {
     "type": "number"
    }
   }
  },
  "axis_path": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "x",
     "y"
    ],
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "integer",
      "minimum": 0
     },
     "y": {
      "type": "integer",
      "minimum": 0
     },
     "dx_mm": {
      "type": "number"
     },
     "dy_mm": {
      "type": "number"
     }
    }
   }
  },
  "segment": {
   "type": "object",
   "required": [
    "type"
   ],
   "oneOf": [
    {
     "description": "凹进（门廊/采光井）",
     "properties": {
      "type": {
       "const": "recess"
      },
      "at_edge": {
       "$ref": "#/$defs/side"
      },
      "offset_m": {
       "type": "number",
       "minimum": 0
      },
      "width_m": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "depth_m": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "required": [
      "type",
      "at_edge",
      "offset_m",
      "width_m",
      "depth_m"
     ],
     "additionalProperties": false
    },
    {
     "description": "凸出（凸窗/阳台挑出）",
     "properties": {
      "type": {
       "const": "projection"
      },
      "at_edge": {
       "$ref": "#/$defs/side"
      },
      "offset_m": {
       "type": "number",
       "minimum": 0
      },
      "width_m": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "depth_m": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "required": [
      "type",
      "at_edge",
      "offset_m",
      "width_m",
      "depth_m"
     ],
     "additionalProperties": false
    },
    {
     "description": "圆角（顶点倒圆角）",
     "properties": {
      "type": {
       "const": "arc"
      },
      "at_vertex": {
       "type": "integer",
       "minimum": 0
      },
      "radius_m": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "required": [
      "type",
      "at_vertex",
      "radius_m"
     ],
     "additionalProperties": false
    }
   ]
  },
  "point_mm": {
   "type": "array",
   "prefixItems": [
    {
     "type": "number"
    },
    {
     "type": "number"
    }
   ],
   "minItems": 2,
   "maxItems": 2
  },
  "axis_arcs": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/axis_arc"
   }
  },
  "axis_arc": {
   "type": "object",
   "required": [
    "at",
    "center",
    "radius"
   ],
   "additionalProperties": false,
   "properties": {
    "at": {
     "type": "integer",
     "minimum": 0
    },
    "center": {
     "type": "object",
     "required": [
      "x",
      "y"
     ],
     "additionalProperties": false,
     "properties": {
      "x": {
       "type": "integer",
       "minimum": 0
      },
      "y": {
       "type": "integer",
       "minimum": 0
      },
      "dx_mm": {
       "type": "number"
      },
      "dy_mm": {
       "type": "number"
      }
     }
    },
    "radius": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "a0": {
     "type": "number"
    },
    "a1": {
     "type": "number"
    }
   }
  }
 }
}
